# Copy to .env.local for local dev. Never commit .env.local.

# Session signing secret (generate with: openssl rand -hex 32)
AUTH_SECRET=REPLACE_WITH_RANDOM_HEX_32

# Admin password hash (generate with: node -e "const {scryptSync,randomBytes}=require('crypto');const s=randomBytes(16);console.log(s.toString('hex')+':'+scryptSync('plmqazoknwsxijbedc',s,64).toString('hex'))")
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH

# Bearer token Kiboy uses to call /api/ingest (generate with: openssl rand -hex 24)
INGEST_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Set by wrangler bindings in production — not needed locally if using wrangler pages dev
# D1_DATABASE_ID=
# R2_BUCKET_NAME=kimedia-thumbs
